{
  "name": "aperio",
  "version": "0.0.0",
  "private": true,
  "description": "A small local assistant that remembers. Rebuild core (v2).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/start-app.mjs",
    "test": "node --test",
    "test:coverage": "c8 --reporter=text --reporter=lcov node --test",
    "lint": "eslint .",
    "guard:size": "node scripts/guard-file-size.mjs",
    "guard:names": "node scripts/guard-duplicate-basenames.mjs",
    "guards": "npm run guard:size && npm run guard:names",
    "gen:env": "node scripts/gen-env-example.mjs",
    "gen:env:check": "node scripts/gen-env-example.mjs --check",
    "try:search": "node scripts/try-search.mjs",
    "import:v1": "node scripts/import-v1.mjs",
    "check": "npm run lint && npm run guards && npm run gen:env:check && npm test",
    "ledgers": "node trash/plans/aperio-v2/scripts/check-ledgers.mjs",
    "model:fetch": "node scripts/fetch-embedding-model.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "sqlite-vec": "^0.1.9",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.14.0"
  }
}
