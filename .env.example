# Aperio - configuration template (AUTO-GENERATED from src/config/registry.js)
# Run `npm run gen:env` after editing the registry; never edit this file by hand.
# Copy to `.env` and uncomment only what you change. Every line shows its default.

# --- Tier 0 - env only. Bootstrap and security; the Settings DB cannot change these.

# Who wins when a key is in both the Settings DB and the environment. db = the Settings DB; env = the environment.
# Options: db | env
# APERIO_CONFIG_PRECEDENCE=db

# Port the web app listens on.
# PORT=3000

# Interface the web app binds to. 0.0.0.0 exposes it to your network.
# HOST=127.0.0.1

# Where the SQLite database lives.
# SQLITE_PATH=./.sqlite/aperio.db

# Comma-separated absolute folders the file tools may read and write. Empty = none.
# APERIO_ALLOWED_PATHS=

# Folder that holds the llama-server binary.
# LLAMACPP_VENDOR_DIR=vendor/llamacpp

# Largest WebSocket message the server accepts, in bytes (256 KiB). A bigger one gets a too_large error. Env only: a security limit. Spec S2.11.
# WS_MAX_FRAME_BYTES=262144

# Most WebSocket clients open at once. One more gets HTTP 503. Env only: a security limit. Spec S2.14.
# WS_MAX_CLIENTS=4

# --- Tier 1 - the Settings DB may override these (see APERIO_CONFIG_PRECEDENCE).

# The local model llama-server loads (Hugging Face repo:quant or a path).
# LLAMACPP_MODEL=unsloth/gemma-4-E4B-it-qat-GGUF:Q4_K_XL

# Port llama-server listens on (127.0.0.1 only).
# LLAMACPP_PORT=8080

# Most context llama-server may allocate. The server gets min(this, the model maximum); the token budget uses the n_ctx the server reports.
# LLAMACPP_SERVE_CTX=65536

# CPU threads for llama-server. 0 = auto: performance cores minus EMBEDDING_THREADS, so the two models do not fight for cores.
# LLAMACPP_THREADS=0

# How long to wait for llama-server to load the model and answer /health, in ms.
# LLAMACPP_START_TIMEOUT_MS=120000

# Model download cache. Empty = the llama.cpp default.
# LLAMA_CACHE=

# Local transformers embedding model. A change flags every memory for re-embedding.
# EMBEDDING_MODEL=mixedbread-ai/mxbai-embed-large-v1

# CPU threads the embedding model may use. Uncapped it took half the cores and slowed llama.cpp.
# EMBEDDING_THREADS=2

# Local cache folder for the embedding model.
# TRANSFORMERS_CACHE=~/.cache/aperio/transformers

# How many memories auto-recall adds to a turn, at most, and the recall tool default when the model does not say (at most 10).
# RECALL_TOP_K=5

# Token cap for recalled memories per turn (counted as characters / 3). Measured max block at score 50: 607. Spec S2.6, back in S2.7 rev 4.
# RECALL_TOKEN_BUDGET=800

# Auto-recall adds a memory only when its meaning match is at least this, in percent (50 = cosine 0.50). Spec S2.6, back in S2.7 rev 4.
# RECALL_MIN_SCORE=50

# Tokens kept free in the context window for the answer. Spec S2.13.
# CONTEXT_OUTPUT_RESERVE=2048

# When history reaches this percent of the free window, the oldest whole turns are cut. Spec S2.13.
# CONTEXT_TRIM_AT_PCT=85

# A cut goes down to this percent of the free window: few, big cuts keep the KV cache. Spec S2.13.
# CONTEXT_TRIM_TO_PCT=60

# Most of the free window one tool result may use, in percent; a bigger one keeps its head and tail. Spec S2.13.
# CONTEXT_TOOL_RESULT_PCT=25

# The remember tool does not save a fact when a stored one matches it at least this much, in percent (80 = cosine 0.80). Measured: duplicates 81-90, new facts <= 76. Spec S2.7.
# REMEMBER_DUP_SCORE=80

# How many memories the list tool returns when the model does not say (at most 50). Spec S2.8.
# LIST_LIMIT=20

# Largest file the file gate reads, in bytes. Spec S2.9.
# FILE_READ_MAX_BYTES=512000

# Largest content the file gate writes, in bytes. Spec S2.9.
# FILE_WRITE_MAX_BYTES=512000

# Days of chat history to keep.
# SESSION_RETENTION_DAYS=14

# How much the app logs.
# Options: error | warn | info | debug
# LOG_LEVEL=info
