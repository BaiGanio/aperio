{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom", "dom.iterable"],
    "rootDirs": ["public", "src"],
    "skipLibCheck": true,
    "types": []
  },
  "include": ["public/**/*.js", "src/shared/ws-schema.js"]
}
