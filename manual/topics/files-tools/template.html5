<!DOCTYPE html>
<html lang="$if(lang)$$lang$$else$en$endif$">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="$description$">
  <meta name="author" content="$for(author)$$author$$sep$, $endfor$">
  <title>$title$</title>
$for(css)$
  <link rel="stylesheet" href="$css$">
$endfor$
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to main content</a>
  <div class="cover-page">
    <div class="running-top"><span>Aperio manual</span><span class="signal-id">$eyebrow$</span></div>
    <div class="cover-panel">
      <div class="cover-grid">
        <div class="cover-copy">
          <p class="eyebrow">$eyebrow$</p>
          <h1>$title$</h1>
$if(subtitle)$
          <p>$subtitle$</p>
$endif$
        </div>
$if(mascot)$
        <figure class="cover-art">
          <div class="aurora-window">
            <img src="$mascot$" alt="Aperio's small retro-radio robot, lit by violet, pink, and cyan aurora bands.">
          </div>
$if(mascotcaption)$
          <figcaption>$mascotcaption$</figcaption>
$endif$
        </figure>
$endif$
      </div>
$if(routes)$
      <nav class="route-panel" aria-label="What's inside">
        <p class="route-label">What's inside</p>
        <ol>
$for(routes)$
          <li><a href="#$routes.href$"><span>$routes.num$</span><span><strong>$routes.label$</strong><small>$routes.desc$</small></span></a></li>
$endfor$
        </ol>
      </nav>
$endif$
    </div>
  </div>
  <main id="main-content">
$body$
  </main>
</body>
</html>
